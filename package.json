{
  "name": "reconnection-service",
  "version": "1.0.0",
  "description": "A microservice to reconnect graphs in DSNP/Frequency",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "nest build",
    "build:swagger": "echo 'webhook-specification/v1.0/connections.yaml'",
    "generate-swagger-ui": "npx --yes @redocly/cli build-docs webhook-specification/v1.0/connections.yaml --output=./docs/index.html",
    "format": "prettier --write \"src/**/*.ts\"",
    "start:api": "nest start",
    "start:api:watch": "nest start --watch",
    "start:api:prod": "node dist/src/main.js",
    "start:api:dev": "set -a ; . .env ; nest start",
    "start:api:debug": "set -a ; . .env ; nest start --debug --watch",
    "docker-build": "docker build -t reconnection-service .",
    "docker-build:dev": "docker compose build",
    "docker-run": "docker build -t reconnection-service-deploy . ; docker run -p 6379:6379 --env-file .env reconnection-service-deploy",
    "docker-run:dev": "docker compose up -d ; docker compose -f docker compose.dev.yaml logs",
    "docker-stop:dev": "docker compose stop",
    "clean": "rm -Rf dist",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest  --coverage --verbose",
    "chain-setup": "tsx setup/testing/index.ts",
    "reset-chain": "setup/testing/reset_chain"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProjectLibertyLabs/reconnection-service.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ProjectLibertyLabs/reconnection-service/issues"
  },
  "homepage": "https://github.com/ProjectLibertyLabs/reconnection-service#readme",
  "dependencies": {
    "@bull-board/api": "^6.12.7",
    "@bull-board/express": "^6.12.7",
    "@bull-board/nestjs": "^6.12.7",
    "@bull-board/ui": "^6.12.7",
    "@frequency-chain/api-augment": "1.17.3",
    "@frequency-chain/ethereum-utils": "1.17.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/testing": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@polkadot/api": "^16.4.6",
    "@polkadot/api-base": "^16.4.6",
    "@polkadot/keyring": "^13.5.6",
    "@polkadot/types": "^16.4.6",
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@projectlibertylabs/graph-sdk": "^2.0.1",
    "@songkeys/nestjs-redis": "^11.0.0",
    "axios": "^1.11.0",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "joi": "^18.0.1",
    "rxjs": "^7.8.2",
    "time-constants": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@jest/globals": "^30.1.2",
    "@nestjs/cli": "^11.0.10",
    "@types/jest": "^30.0.0",
    "@types/time-constants": "^1.0.2",
    "dotenv": "^17.2.2",
    "eslint": "^9.34.0",
    "eslint-plugin-jest": "^29.0.1",
    "jest": "^30.1.3",
    "license-report": "^6.8.0",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
